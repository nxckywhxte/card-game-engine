    <artifactId>engine-rules-klondike</artifactId>
    <name>Card Game Engine - Klondike Rules</name>
    <description>
        Implementation of "Klondike" solitaire rules.
        Contains game logic: tableau building (alternating colors),
        foundation building (by suit, ascending), stock/waste mechanics,
        and win conditions.
        Implements the GameRules interface from the API module.
    </description>

    <dependencies>
