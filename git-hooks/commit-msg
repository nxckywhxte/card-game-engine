#!/bin/sh

commit_msg_file=$1

# Проверяем, что файл сообщения коммита существует
if [ ! -f "$commit_msg_file" ]; then
    echo "❌ Commit message file not found!"
    exit 1
fi

# Читаем сообщение коммита
commit_msg=$(cat "$commit_msg_file")

# Регулярное выражение для Conventional Commits
pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?: .{1,100}$"

# Проверяем формат напрямую через grep
if ! echo "$commit_msg" | grep -qE "$pattern"; then
    echo "❌ Commit message does not follow Conventional Commits format!"
    echo ""
    echo "Expected format: <type>(<scope>): <description>"
    echo ""
    echo "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
    echo "Examples:"
    echo "  feat(core): add Card record with immutability"
    echo "  fix(api): resolve null pointer in Zone interface"
    echo "  ci: update GitHub Actions to use Node.js 24"
    echo ""
    echo "Your message: $commit_msg"
    exit 1
fi

echo "✅ Commit message format is valid!"
exit 0