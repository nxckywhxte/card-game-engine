# Автоматическая нормализация переносов строк
* text=auto

# Java-файлы всегда с LF (Unix-style)
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Скрипты Maven Wrapper должны быть исполняемыми
mvnw text eol=lf

# Бинарные файлы (не нормализовать)
*.jar binary
*.png binary
*.jpg binary
*.gif binary